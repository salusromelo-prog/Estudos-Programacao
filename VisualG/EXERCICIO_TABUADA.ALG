Algoritmo "exercicio_tabuada"

Var

     N , i , resultado : inteiro

Inicio

      escreva ("Deseja a tabuada para qual valor? ")
      leia (N)
        resultado <- 0
        
        
      para i de 1 ate 10 faca
         resultado <- N * i
         escreval (N ," X ",i," = ",resultado )
      
      
      
      fimpara

Fimalgoritmo