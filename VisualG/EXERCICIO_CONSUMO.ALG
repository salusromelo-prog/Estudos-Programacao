Algoritmo "exercicio_consumo"

Var


   distancia, combustivel , consumo : real
   

Inicio

   escreva ("Distancia percorrida:")
   leia (distancia)
   escreva ("Combustivel gasto: ")
   leia(combustivel)

   consumo <- distancia / combustivel
   
   escreva ("O consumo medio foi de: " , consumo:6:3 )

Fimalgoritmo